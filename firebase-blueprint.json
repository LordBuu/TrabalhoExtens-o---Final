{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de professor ou administrador no NeuroEdu",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador do usuário no Firebase Auth"
        },
        "name": {
          "type": "string",
          "description": "Nome completo do professor",
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "description": "E-mail do professor",
          "maxLength": 254
        },
        "institution": {
          "type": "string",
          "description": "Escola ou instituição educacional",
          "maxLength": 200
        },
        "subjectArea": {
          "type": "string",
          "description": "Área de atuação pedagógica (Linguagens, Matemática, etc)",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Nível de acesso do usuário",
          "enum": ["teacher", "admin"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp de criação"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp de última alteração"
        }
      },
      "required": ["id", "name", "email", "role"]
    },
    "ScientificSource": {
      "title": "ScientificSource",
      "description": "Artigo ou diretriz científica revisada por pares",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Título da pesquisa ou publicação",
          "maxLength": 300
        },
        "authors": {
          "type": "string",
          "description": "Autores do estudo",
          "maxLength": 300
        },
        "year": {
          "type": "number",
          "description": "Ano de publicação"
        },
        "journal": {
          "type": "string",
          "description": "Periódico ou instituição publicadora",
          "maxLength": 200
        },
        "doi": {
          "type": "string",
          "description": "Identificador DOI do artigo",
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "description": "Link oficial de acesso",
          "maxLength": 500
        },
        "abstract": {
          "type": "string",
          "description": "Resumo metodológico e pedagógico",
          "maxLength": 2500
        },
        "keywords": {
          "type": "array",
          "description": "Palavras-chave para indexação RAG"
        },
        "neurodivergence": {
          "type": "string",
          "description": "Condição ou espectro neurodivergente principal",
          "maxLength": 100
        },
        "ageRange": {
          "type": "string",
          "description": "Faixa etária foco (ex: 13-17 anos, Ensino Médio)",
          "maxLength": 100
        },
        "educationalContext": {
          "type": "string",
          "description": "Contexto escolar de aplicação",
          "maxLength": 150
        },
        "intervention": {
          "type": "string",
          "description": "Tipo de intervenção educacional analisada",
          "maxLength": 200
        },
        "evidenceLevel": {
          "type": "string",
          "description": "Classificação metodológica de evidência",
          "enum": [
            "Revisão sistemática",
            "Meta-análise",
            "Ensaio clínico/controlado",
            "Estudo observacional",
            "Estudo qualitativo",
            "Diretriz/consenso",
            "Revisão narrativa",
            "Fonte institucional"
          ]
        },
        "content": {
          "type": "string",
          "description": "Texto estruturado das descobertas e recomendações práticas",
          "maxLength": 8000
        },
        "demo": {
          "type": "boolean",
          "description": "Indicador se é dado demonstrativo"
        },
        "createdAt": {
          "type": "string",
          "description": "Data de cadastro"
        }
      },
      "required": ["title", "authors", "year", "evidenceLevel", "neurodivergence"]
    },
    "Strategy": {
      "title": "Strategy",
      "description": "Estratégia pedagógica prática para sala de aula",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nome da estratégia",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Descrição sucinta da intervenção",
          "maxLength": 1500
        },
        "targetAudience": {
          "type": "string",
          "description": "Público-alvo no Ensino Médio",
          "maxLength": 200
        },
        "situation": {
          "type": "string",
          "description": "Cenário de sala de aula em que é indicada",
          "maxLength": 1000
        },
        "howToApply": {
          "type": "string",
          "description": "Passo a passo prático para aplicação pelo professor",
          "maxLength": 3000
        },
        "expectedBenefits": {
          "type": "string",
          "description": "Resultados observáveis na aprendizagem",
          "maxLength": 1000
        },
        "limitations": {
          "type": "string",
          "description": "Cuidados, limitações e contraindicações",
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "description": "Categoria temática da adaptação",
          "maxLength": 100
        },
        "referenceIds": {
          "type": "array",
          "description": "Identificadores das fontes científicas vinculadas"
        },
        "demo": {
          "type": "boolean",
          "description": "Indicador de exemplo/demonstração"
        },
        "createdAt": {
          "type": "string",
          "description": "Data de criação"
        }
      },
      "required": ["name", "description", "situation", "howToApply"]
    },
    "Question": {
      "title": "Question",
      "description": "Registro de consulta e resposta gerada pelo Assistente IA com RAG",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do professor autor"
        },
        "question": {
          "type": "string",
          "description": "Situação descrita pelo professor",
          "maxLength": 2500
        },
        "answer": {
          "type": "string",
          "description": "Resposta estruturada gerada pela IA",
          "maxLength": 15000
        },
        "sources": {
          "type": "array",
          "description": "Fontes científicas resgatadas da biblioteca"
        },
        "category": {
          "type": "string",
          "description": "Categoria pedagógica atribuída",
          "maxLength": 100
        },
        "hasSufficientEvidence": {
          "type": "boolean",
          "description": "Indica se foram encontradas evidências específicas na base"
        },
        "createdAt": {
          "type": "string",
          "description": "Data e hora da consulta"
        }
      },
      "required": ["userId", "question", "answer", "createdAt"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Item salvo pelo professor para consulta rápida",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do professor"
        },
        "itemType": {
          "type": "string",
          "description": "Tipo do item favoritado",
          "enum": ["article", "strategy", "answer"]
        },
        "itemId": {
          "type": "string",
          "description": "ID do recurso correspondente",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Título descritivo do item salvo",
          "maxLength": 300
        },
        "snippet": {
          "type": "string",
          "description": "Trecho para pré-visualização rápida",
          "maxLength": 800
        },
        "category": {
          "type": "string",
          "description": "Categoria temática",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Momento em que foi salvo"
        }
      },
      "required": ["userId", "itemType", "itemId", "title", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Perfis privados de professores e administradores"
    },
    "/scientific_sources/{sourceId}": {
      "schema": "ScientificSource",
      "description": "Repositório de evidências científicas e artigos"
    },
    "/strategies/{strategyId}": {
      "schema": "Strategy",
      "description": "Repositório de estratégias pedagógicas práticas"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Histórico de perguntas e respostas RAG dos professores"
    },
    "/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "Itens favoritos salvos pelos professores"
    }
  }
}
